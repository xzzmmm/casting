  "wordlist": {
    "命运宿命类": ["命运", "宿命", "天命", "劫数", "注定", "因果", "轮回"],
    "黑暗神秘类": ["黑暗", "深渊", "混沌", "虚妄", "幻影", "亡灵", "诅咒", "封印"],
    "光辉神圣类": ["光芒", "曙光", "圣光", "永恒", "不朽", "救赎", "审判", "天罚", "净化"],
    "力量权能类": ["觉醒", "潜能", "究极", "极限", "契约", "誓约", "王座", "王者", "支配", "征服", "裁决", "禁忌", "终结"],
    "贬低凡人感": ["蝼蚁", "凡人", "愚昧", "可悲", "卑微"],
    "史诗古风类": ["吾", "汝", "苍生", "苍穹", "洪荒", "九霄", "陨落", "黎明"]
  },
  "abstract_words": [
    "命运", "宿命", "时代", "世界", "觉悟", "意志", "真理", "正义",
    "永恒", "黑暗", "光明", "灵魂", "信念", "希望", "绝望", "羁绊", "誓言", "承诺"
  ],
  "templates": [
    {"pattern": "^我是.{0,10}(王|神|选中|继承)", "label": "我是XXX（王/神/选中者）"},
    {"pattern": "^我即是|^吾乃", "label": "我即是/吾乃"},
    {"pattern": ".{0,10}的命运.{0,10}(终结|决定|掌握)", "label": "……的命运……"},
    {"pattern": "^.{0,8}的时代(已经)?结束", "label": "……的时代结束了"},
    {"pattern": "^你竟敢", "label": "你竟敢……"},
    {"pattern": "^给我.{0,6}[！!]$", "label": "给我……！"},
    {"pattern": ".{0,8}到此为止(了)?$", "label": "……到此为止了"},
    {"pattern": "^这就是.{0,12}(力量|觉悟|意志)", "label": "这就是……（力量/觉悟/意志）"},
    {"pattern": "^感受.{0,6}吧", "label": "感受……吧"},
    {"pattern": "^世界(不过|终究|只是)", "label": "世界不过是……"},
    {"pattern": ".{0,8}(最讨厌了|才是正义|才是真理)$", "label": "……最讨厌了/才是正义"},
    {"pattern": "^你以为.{0,12}(太天真|可笑|错了)", "label": "你以为……太天真了"}
  ],
  "weights": {
    "wordlist_hit": 25,
    "absolutism": 12,
    "exclamation": 15,
    "abstract_heavy": 12,
    "template_hit": 20,
    "long_line": 10,
    "semantic": 0.3
  },
  "thresholds": {
    "hit_per_line": 2,
    "exclaim_ratio": 0.3,
    "abstract_ratio": 0.5,
    "long_line": 40,
    "absolutism_words": ["永远", "绝不", "一切", "所有", "必须", "一定"]
  },
  "calibration": {
    "villain_or_climax": 0.6,
    "daily": 1.3,
    "chuuni_character": 0.4,
    "default": 1.0,
    "climax_scene_types": ["climax", "villain_entrance"]
  },
  "levels": [
    {"max": 30, "label": "正常", "action": "无需处理"},
    {"max": 60, "label": "偶发", "action": "提示级：单句标注，不打断阅读"},
    {"max": 85, "label": "明显中二", "action": "定位 + 信号证据 + 降档建议"},
    {"max": 999, "label": "严重", "action": "阻断级：整段重写建议，进入高优问题列表"}
  ]
}
